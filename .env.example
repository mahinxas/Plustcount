# Copy to .env (never commit .env) and fill in.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=viestit.example.fi
DJANGO_CSRF_TRUSTED_ORIGINS=https://viestit.example.fi
DATABASE_URL=postgres://cms:cms@localhost:5432/cms
CELERY_BROKER_URL=redis://localhost:6379/0

# Email through the Brevo API. Create the key in Brevo: SMTP & API > API keys.
# The sender address must be verified in Brevo: Senders, domains & dedicated IPs.
BREVO_API_KEY=
DEFAULT_FROM_EMAIL=Tilitoimisto <viestit@example.fi>
# Brevo free plan: 300 emails a day. Raise it after upgrading; 0 = no limit.
EMAIL_DAILY_LIMIT=300
# Timezone where Brevo's day starts (not documented by Brevo; confirm with their support).
EMAIL_LIMIT_TIMEZONE=UTC

# Keep ON until the client approves going live. With test mode on, no real
# client receives anything: mail goes to MESSAGING_TEST_RECIPIENT, or only to
# the server log when that is empty.
MESSAGING_TEST_MODE=1
MESSAGING_TEST_RECIPIENT=
# Your own test clients that should get their emails directly, comma separated.
MESSAGING_TEST_ALLOWED=
# Your own phone: in test mode every SMS goes here (empty = SMS are only logged).
MESSAGING_TEST_PHONE=

# SMS. Until a provider is chosen, SMS are only written to the log.
SMS_BACKEND=messaging.sms.ConsoleBackend
# Own modem + SIM through Gammu (see README): SMS_BACKEND=messaging.sms.GammuBackend
GAMMU_INJECT_COMMAND=gammu-smsd-inject
GAMMU_CONFIG=/etc/gammu-smsdrc
# Paired Android phone through KDE Connect: SMS_BACKEND=messaging.sms.KdeConnectBackend
KDECONNECT_COMMAND=kdeconnect-cli
KDECONNECT_DEVICE=
# Android phone with the SMS Gate app (sms-gate.app): SMS_BACKEND=messaging.sms.SmsGateBackend
SMSGATE_USERNAME=
SMSGATE_PASSWORD=
SMS_SEND_DELAY_SECONDS=3
# Optional cap on SMS per day (0 = no limit; SMS Gate has none).
SMS_DAILY_LIMIT=0
# Sender name on the phone, max 11 letters or digits.
SMS_SENDER=Kirjanpito

SESSION_IDLE_TIMEOUT_SECONDS=1800

# --- Production extras ---
# Shared cache for the login throttle. Defaults to CELERY_BROKER_URL, so usually leave empty.
REDIS_URL=
# Error alerts: create an EU-region project at sentry.io and paste its DSN. Empty = off.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Gunicorn web workers (default 3).
WEB_CONCURRENCY=3
